{
  "name": "versekit",
  "version": "0.3.1",
  "private": true,
  "description": "Local-first publish + own-account analytics control plane for multi-platform creators",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "hifabu": "./packages/cli/src/vk.mjs",
    "vk": "./packages/cli/src/vk-alias.mjs"
  },
  "scripts": {
    "hifabu": "node packages/cli/src/vk.mjs",
    "vk": "node packages/cli/src/vk-alias.mjs",
    "serve": "node packages/cli/src/vk.mjs serve --open",
    "doctor": "node packages/cli/src/vk.mjs doctor --human",
    "test": "node scripts/ci/test-all.mjs",
    "check:parity": "node scripts/ci/parity.mjs",
    "check:contract": "node scripts/ci/adapter-contract.mjs",
    "check:backdoor": "node scripts/ci/no-backdoor.mjs",
    "check:brand": "node scripts/ci/check-brand.mjs",
    "design:check": "node scripts/design-check.mjs",
    "check": "npm run check:brand && npm test && npm run design:check",
    "ci": "npm run check:parity && npm run check:contract && npm run check:backdoor && npm run check",
    "design:accept": "node scripts/design-accept.mjs",
    "agentctl": "node bin/agentctl.mjs"
  }
}
