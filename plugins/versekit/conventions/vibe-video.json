{
  "project": "vibe-video",
  "language": "zh",
  "videoDirectory": "成片",
  "videoPattern": "^(?<episode>[0-9]{2})_(?<topic>[^_]+?)(?:_(?<variant>(?!v[0-9]+\\.mp4$)[^/]+?))?(?:_v(?<version>[1-9][0-9]*))?\\.mp4$",
  "coverTemplate": "成片/封面/{episode}_{topic}_封面.png",
  "copyFile": "文案/发布文案.md",
  "copyHeadingPattern": "^##[ \\t]+(?<episode>[0-9]{2})[ \\t]+(?<topic>.+?)\\s*$",
  "subtitleTemplate": "文案/{episode}_{topic}_文案.txt"
}
