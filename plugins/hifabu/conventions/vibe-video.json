{
  "project": "vibe-video",
  "language": "zh",
  "videoDirectory": "成片",
  "videoPattern": "^(?<episode>[0-9]{2})_(?<topic>[^_]+?)(?:_(?<variant>(?!v[0-9]+\\.mp4$)[^/]+?))?(?:_v(?<version>[1-9][0-9]*))?\\.mp4$",
  "coverTemplate": "成片/封面/{episode}_{topic}_封面.png",
  "variantCoverTemplate": "成片/封面/{episode}_{topic}_{variant}_封面.png",
  "copyFile": "成片/文案/发布文案.md",
  "copyHeadingPattern": "^##[ \\t]+(?<episode>[0-9]{2})[ \\t]+(?<topic>.+?)\\s*$",
  "originalCopyVariants": {
    "17_AI算法简史": "革命练习曲版"
  },
  "subtitleTemplate": "成片/文案/{episode}_{topic}_文案.txt"
}
